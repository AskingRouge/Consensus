# Copy this file to backend/.env and fill in real values for local dev.
# Never commit the real .env — it's already in .gitignore.

# Local dev default matches docker-compose.yml's mongo service. Swap for
# an Atlas SRV connection string (mongodb+srv://...) at any time — the app
# doesn't care which it's talking to.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=consensus

# Port the Go server listens on.
PORT=8080

# Used for CORS — must match where the Vite dev server (or, later, the
# deployed frontend) is served from.
FRONTEND_URL=http://localhost:5173

# --- Google OAuth (Phase 2) ---
# From Google Cloud Console > APIs & Services > Credentials. See the
# README's "Google OAuth setup" section for the exact steps and redirect
# URI to register.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated allowlist of emails permitted to log in.
ALLOWED_EMAILS=you@unc.edu,teammate@unc.edu

# Random long string used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=
